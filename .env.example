# 데이터베이스 (필수)
DB_URL=jdbc:mysql://<host>:<port>/<database>
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=
DB_PASSWORD=

# Redis (필수)
REDIS_HOST=
REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_DATABASE=0

# 선택 (기본값 있음)
# SERVER_PORT=10411
# ACCOUNT_BASE_URL=http://account
# RULE_ENGINE_BASE_URL=http://rule-engine

# 메일
# 초대 메일 발송에 사용. 초대 메일을 쓰지 않으면 비워도 됨.
MAIL_USERNAME=
MAIL_PASSWORD=

# 외부 API
# AI 리포트 요약 및 챗봇용. AI 기능을 쓰지 않으면 비워도 됨.
GOOGLE_API_KEY=